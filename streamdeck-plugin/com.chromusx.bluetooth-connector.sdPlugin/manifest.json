{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Bluetooth Device Connector",
	"Version": "1.1.0.5",
	"Author": "chromusx",
	"Description": "Connect or disconnect paired Bluetooth devices from Stream Deck. On Windows, choose stereo-only or stereo plus microphone per key and route playback to the connected device, with clear key and sound feedback.",
	"URL": "https://github.com/ChromuSx/BluetoothDeviceConnector",
	"Icon": "imgs/plugin-icon",
	"CodePath": "bin/plugin.js",
	"PropertyInspectorPath": "ui/property-inspector.html",
	"SDKVersion": 3,
	"Nodejs": {
		"Version": "20"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Software": {
		"MinimumVersion": "6.9"
	},
	"UUID": "com.chromusx.bluetooth-connector",
	"Category": "Bluetooth Device Connector",
	"CategoryIcon": "imgs/category-icon",
	"Actions": [
		{
			"Name": "Connect Bluetooth Device",
			"UUID": "com.chromusx.bluetooth-connector.connect",
			"Icon": "imgs/action-icon",
			"Tooltip": "Toggle Bluetooth device connection with visual status indicators and audio feedback",
			"States": [
				{
					"Image": "imgs/key-disconnected",
					"Name": "Disconnected"
				},
				{
					"Image": "imgs/key-connecting",
					"Name": "Connecting"
				},
				{
					"Image": "imgs/key-connected",
					"Name": "Connected"
				},
				{
					"Image": "imgs/key-error",
					"Name": "Error"
				}
			],
			"PropertyInspectorPath": "ui/property-inspector.html",
			"SupportedInMultiActions": true,
			"UserTitleEnabled": true
		}
	]
}